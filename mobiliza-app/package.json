{
  "name": "santander-mobiliza-prototipo",
  "private": true,
  "version": "0.1.0",
  "description": "Protótipo acadêmico não oficial: orientação de mobilidade e finanças a partir da rotina do usuário",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:arquivo-unico": "tsc -b && vite build --mode arquivo-unico",
    "build:publicar": "tsc -b && vite build --mode publicar",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide": "0.441.0",
    "lucide-react": "0.441.0",
    "qrcode-generator": "1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/node": "22.5.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "vite-plugin-singlefile": "2.0.2",
    "vitest": "2.0.5"
  }
}
